-- ================================
-- ITEMS TABLE
-- ================================
CREATE TABLE IF NOT EXISTS items (
    id INT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(200) NOT NULL,
    description TEXT NOT NULL,
    category_id INT,
    item_type ENUM('lost','found') DEFAULT 'found',
    date_found DATE NOT NULL,
    date_lost DATE,
    location_id INT,
    exact_location VARCHAR(500),
    status ENUM('pending','published','claimed') DEFAULT 'pending',
    image_url VARCHAR(255),
    finder_name VARCHAR(100),
    finder_contact VARCHAR(100),
    finder_email VARCHAR(100),
    finder_phone VARCHAR(20),
    claimant_name VARCHAR(100),
    claimant_contact VARCHAR(100),
    claim_date DATE,
    user_id INT,
    admin_notes TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (category_id) REFERENCES categories(id),
    FOREIGN KEY (location_id) REFERENCES locations(id),
    FOREIGN KEY (user_id) REFERENCES users(id)
);

